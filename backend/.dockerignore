# The Dockerfile does `COPY . .`, so anything not excluded here is baked into
# the image. CI builds from a clean clone and never sees these, but a local
# `docker build` would otherwise ship developer files - most importantly .env,
# whose DEBUG=True would win for any variable the deployment does not set.
.env
.env.*
*.env

venv/
.venv/
__pycache__/
*.py[cod]

# User uploads belong on the media volume, not in the image.
media/

db.sqlite3
*.log
.git/
.gitignore
staticfiles/
