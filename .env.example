# Variables for `docker compose up`. Copy to `.env` (git-ignored) and fill in.

DJANGO_SECRET_KEY=change-me
POSTGRES_DB=budget_tracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=secret

# Public origin of the SPA. Register exactly this value as redirect URI at
# every provider and use it inside the VITE_*_LINK URLs below. No trailing slash.
FRONTEND_URL=http://localhost:3000

# Full authorization URLs, one per provider. An empty value hides that button.
VITE_GOOGLE_LINK=
VITE_GITHUB_LINK=
VITE_MICROSOFT_LINK=

# Set to True for tracebacks in the browser; never in production.
DEBUG=False
