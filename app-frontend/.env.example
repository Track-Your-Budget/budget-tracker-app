VITE_GOOGLE_CLIENT_ID=
# VITE_GITHUB_CLIENT_ID=
# VITE_MICROSOFT_CLIENT_ID=

# Full OAuth authorization URLs used by the social login buttons. When unset,
# the corresponding button is hidden.
#   Google:    implicit flow — must include response_type=token
#   GitHub:    authorization-code flow — response_type defaults to "code"
#   Microsoft: authorization-code flow — must include response_type=code
#              and scope=openid%20email%20profile%20User.Read (or similar)
VITE_GOOGLE_LINK=
VITE_GITHUB_LINK=
VITE_MICROSOFT_LINK=
